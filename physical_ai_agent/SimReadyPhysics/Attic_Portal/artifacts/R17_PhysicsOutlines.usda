#usda 1.0
(
    doc = "Viewer-owned physics outlines: RigidBodyAPI orange, CollisionAPI green, PhysicsScene blue."
)

def Scope "R17OutlineLooks"
{
    def Material "RigidBodyAPI"
    {
        token outputs:surface.connect = </R17OutlineLooks/RigidBodyAPI/Surface.outputs:surface>
        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.0, 0.0, 0.0)
            color3f inputs:emissiveColor = (0.900, 0.495, 0.045)
            token outputs:surface
        }
    }
    def Material "CollisionAPI"
    {
        token outputs:surface.connect = </R17OutlineLooks/CollisionAPI/Surface.outputs:surface>
        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.0, 0.0, 0.0)
            color3f inputs:emissiveColor = (0.090, 0.900, 0.225)
            token outputs:surface
        }
    }
    def Material "PhysicsScene"
    {
        token outputs:surface.connect = </R17OutlineLooks/PhysicsScene/Surface.outputs:surface>
        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.0, 0.0, 0.0)
            color3f inputs:emissiveColor = (0.225, 0.495, 0.900)
            token outputs:surface
        }
    }
}

