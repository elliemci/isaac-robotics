            (0.970142500145, 0.242535625036, -0, 0),
            (-0.10238452245, 0.409538089801, 0.906529625862, 0),
            (0.219865729422, -0.879462917689, 0.422142200491, 0),
            (-549.163663328, -1408.34534669, 257.005766411, 1)
            )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }
}
