#usda 1.0
(
    defaultPrim = "Session"
)

def Xform "Session"
{
    def Xform "Sensors"
    {
        def OmniLidar "R17Lidar" (
            prepend apiSchemas = ["OmniSensorGenericLidarCoreAPI"]
        )
        {
            token omni:sensor:Core:elementsCoordsType = "CARTESIAN"
            bool omni:sensor:Core:includeInvalidPoints = 0
            bool omni:sensor:Core:instantLidar = 1
            token omni:sensor:Core:outputFrameOfReference = "SENSOR"
            token omni:sensor:Core:outputMotionCompensationState = "NONCOMPENSATED"
            bool omni:sensor:Core:partialOutputs = 0
            double2 omni:sensor:frameRate = (10, 1)
            matrix4d xformOp:transform = ( (1, -0, 0, 0), (0, 0.333487092141, 0.942754665528, 0), (-0, -0.942754665528, 0.333487092141, 0), (-620, -1553.95337282, 272.736626924, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }

    def "Render"
    {
        def "Products"
        {
            def RenderProduct "R17LidarProduct"
            {
                rel camera = </Session/Sensors/R17Lidar>
                rel orderedVars = </Session/Render/Vars/PointCloud>
            }
        }

        def "Vars"
        {
            def RenderVar "PointCloud"
            {
                string[] channels = ["Coordinates", "Intensity", "ObjectId", "Flags", "Counts"]
                uniform string sourceName = "PointCloud"
            }
        }
    }
}

